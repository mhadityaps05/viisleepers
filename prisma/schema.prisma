generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id        String   @id @default(cuid())
  name      String
  category  String
  price     Int
  stock     Int      @default(0)
  images    String[]
  productSizes ProductSize[]
  orderItems OrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Size {
  id           String        @id @default(cuid())
  value        String
  active       Boolean       @default(true)
  productSizes ProductSize[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ProductSize {
  id        String   @id @default(cuid())
  productId String
  sizeId    String
  stock     Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Size     @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sizeId])
  @@index([productId])
  @@index([sizeId])
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerName String
  email        String
  phone        String
  province     String
  city         String
  postalCode   String
  address      String
  subtotal     Int
  shippingFee  Int
  total        Int
  paymentSessionStatus String @default("NOT_STARTED")
  midtransToken String?
  midtransRedirectUrl String?
  status       String      @default("Pending")
  orderStatus  String      @default("Pending")
  shippingCourier String?
  shippingService String?
  estimatedDelivery String?
  destinationAreaId String?
  courier      String?
  trackingNumber String?
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  size            String
  priceAtPurchase Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([subscribedAt])
}

model ReturnRequest {
  id          String   @id @default(cuid())
  email       String
  orderNumber String
  orderItems  String
  reason      String?
  status      String   @default("Pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model Event {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  date        DateTime
  location    String
  posterUrl   String?
  active      Boolean      @default(true)
  ticketTypes TicketType[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TicketType {
  id           String        @id @default(cuid())
  eventId      String
  name         String
  price        Int
  quota        Int
  sold         Int           @default(0)
  active       Boolean       @default(true)
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketOrders TicketOrder[]
  tickets      Ticket[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([eventId])
}

model TicketOrder {
  id                   String     @id @default(cuid())
  orderNumber          String     @unique
  ticketTypeId         String
  buyerName            String
  buyerEmail           String
  buyerPhone           String
  quantity             Int
  priceAtPurchase      Int
  total                Int
  paymentSessionStatus String     @default("NOT_STARTED")
  midtransToken        String?
  midtransRedirectUrl  String?
  status               String     @default("Pending")
  ticketType           TicketType @relation(fields: [ticketTypeId], references: [id])
  tickets              Ticket[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([ticketTypeId])
}

model Ticket {
  id            String      @id @default(cuid())
  ticketOrderId String
  ticketTypeId  String
  buyerName     String
  buyerEmail    String
  code          String?     @unique
  status        String      @default("Valid")
  ticketOrder   TicketOrder @relation(fields: [ticketOrderId], references: [id], onDelete: Cascade)
  ticketType    TicketType  @relation(fields: [ticketTypeId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([ticketOrderId])
  @@index([ticketTypeId])
}